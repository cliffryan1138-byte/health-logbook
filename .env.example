# Logbook — environment
# Both are build-time (VITE_*) and end up in the browser bundle, so they must be
# set in the Vercel project, not only in a local .env. A local build without them
# ships empty strings and the app refuses to start (see src/lib/supabase.js).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
